{
  "name": "@lamplitisles/dsh-tabletop",
  "version": "0.1.1",
  "description": "Host-only structured dice rolls for DeepSeek Harness",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LamplitIsles/dsh-plugins.git",
    "directory": "packages/dsh-tabletop"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/schemastery": "catalog:"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "pack-smoke": "tsx scripts/pack-smoke.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "catalog:",
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
