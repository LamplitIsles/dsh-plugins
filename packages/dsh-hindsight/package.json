{
  "name": "@lamplitisles/dsh-hindsight",
  "version": "0.1.0",
  "description": "A small DSH companion-memory adapter for Hindsight",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/LamplitIsles/dsh-plugins.git",
    "directory": "packages/dsh-hindsight"
  },
  "type": "module",
  "main": "./dist/dsh.js",
  "types": "./dist/dsh.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dsh.d.ts",
      "default": "./dist/dsh.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dsh": {
      "types": "./dist/dsh.d.ts",
      "default": "./dist/dsh.js"
    },
    "./client": {
      "types": "./dist/client.d.cts",
      "default": "./dist/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "pack-smoke": "node scripts/pack-smoke.mjs",
    "recall:eval": "node scripts/recall-eval.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-settings": "catalog:",
    "@deepseek-ai/dsh-system-prompt": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.31",
    "esbuild": "0.25.12",
    "lightningcss": "^1.33.0",
    "react": "catalog:",
    "tsup": "^8.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-settings": "catalog:",
    "@deepseek-ai/dsh-system-prompt": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "react": "catalog:"
  },
  "dependencies": {
    "@vectorize-io/hindsight-client": "0.9.2"
  }
}
