{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": false,
  "sortPackageJson": false,
  "sortTailwindcss": false,
  "svelte": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    ".cache/**",
    ".pnpm-store/**",
    ".release-artifacts/**",
    ".scratch/**",
    "pnpm-lock.yaml",
    "scripts/release-shared.d.ts*"
  ]
}
