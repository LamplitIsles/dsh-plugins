{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
